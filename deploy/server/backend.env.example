# /home/shahed/stack/backend.env  (chmod 600)
# Copied from the Vercel project's environment. Keep JWT_SECRET identical, or
# every signed-in user and merchant is signed out.
JWT_SECRET=
JWT_EXPIRES_IN=7d
API_PREFIX=api/v1
APP_URL=https://api.shahedapp.com
CORS_ORIGINS=https://shahedapp.com,https://www.shahedapp.com,https://admin.shahedapp.com,https://vendor.shahedapp.com
CRON_SECRET=
OTP_EXPIRY_MINUTES=5

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Database, uploads, port and auto-payments are set in docker-compose.yml.
